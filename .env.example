# Square — the live /checkout (pages/checkout.jsx) charges through this via
# the Web Payments SDK (card, Apple Pay, Google Pay, Afterpay — see
# lib/squareClient.js), charged server-side via /api/square-checkout
# (lib/squareServer.js). Also backs /api/admin/orders/refund for orders
# placed while Square was live. From a Square Developer app
# (developer.squareup.com > your app > Credentials/Locations) — this is a
# DIFFERENT Square account/location than any earlier live period this site
# has had, so all four of these need fresh values, not whatever was here
# before.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Same application/location/environment, exposed to the browser so the SDK
# can mount client-side. NEXT_PUBLIC_SQUARE_ENVIRONMENT defaults to
# 'production' if unset — only set it to 'sandbox' explicitly while testing.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox

# QuickBooks Payments — kept as the backup checkout page
# (pages/checkout-qb.jsx), ready to rotate back to if Square ever needs to
# be swapped out (see that file's header comment for how to actually make
# it live). Also backs refunds for orders placed while QuickBooks was live.
# Cards are tokenized client-side directly against Intuit's API
# (lib/qbPayments.js) and charged server-side via /api/qb-checkout
# (lib/qbPaymentsServer.js, which authorizes and captures synchronously —
# no deferred capture step). One-time setup: visit /api/qb-auth/connect
# once (after setting QB_CLIENT_ID/SECRET) to authorize; lib/qbServerAuth.js
# refreshes the token automatically after that — no need to visit it again.
# NEXT_PUBLIC_QB_ENVIRONMENT is the client-side counterpart — checkout-qb.jsx
# tokenizes cards against Intuit's sandbox or production API depending on
# this value; keep it matched to QB_ENVIRONMENT.
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_ENVIRONMENT=sandbox
NEXT_PUBLIC_QB_ENVIRONMENT=sandbox

# Mapbox — address-suggestion autocomplete on every checkout page's Address
# field (components/AddressFields.jsx, lib/addressAutocomplete.js). Get a
# free access token by signing up at mapbox.com (self-serve, no sales
# contact — Radar was tried first but required booking a demo to sign up).
# This token is meant to be exposed in the browser (Mapbox's public tokens
# are scoped/restrictable by URL in your Mapbox account, not secret).
# Leave unset and autocomplete simply never shows suggestions; manual
# address entry always still works.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Stripe — no longer used at checkout. STRIPE_SECRET_KEY is kept only so
# the admin Orders tab can refund older orders placed via Stripe.
STRIPE_SECRET_KEY=

# Bankful — an alternate checkout integration exists in the codebase
# (lib/bankfulServer.js) but isn't currently wired up to /checkout; it hit a
# "merchant not configured" error from Bankful's gateway that needs to be
# resolved with Bankful support before it can be used again. Only needed if
# you have Bankful orders to refund via the admin Orders tab.
BANKFUL_USERNAME=
BANKFUL_PASSWORD=
BANKFUL_ENVIRONMENT=sandbox
BANKFUL_BASE_URL=

# KV store (Vercel KV or a standalone Upstash Redis both work — same REST API)
# used for admin sessions, reviews, discounts, analytics, and the
# QuickBooks refresh token.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Your deployed URL (Vercel sets this; use http://localhost:3000 locally)
NEXT_PUBLIC_BASE_URL=https://your-project.vercel.app

# Password for /admin (revenue, funnel analytics, live visitors, review
# moderation). Sessions are stored in the same KV store above.
ADMIN_PASSWORD=

# Bearer token for /api/leads/export — lets a separate app (e.g. the email/
# subscriber tool) pull captured checkout leads (abandoned + purchased)
# without a browser login. Set this to any long random string and give the
# same value to whatever's calling that endpoint.
LEADS_API_KEY=

# lynns-dev/email — the separate email/subscriber platform (its own repo,
# its own deployment). Complements LEADS_API_KEY above (that's this site
# passively exporting leads for something else to pull; these push
# checkout activity to that app directly, in real time):
# - NEXT_PUBLIC_EMAIL_APP_URL: that deployment's base URL (e.g.
#   https://mail.veilpuff.com). Used both client-side (lib/emailPlatform.js's
#   captureCheckoutEmail(), called from every checkout page's email field
#   on blur — imports the subscriber and starts its abandoned-checkout
#   automation) and server-side (notifyOrderReceived(), called from
#   lib/orderFulfillment.js right after a charge captures — stops that
#   automation so a customer who already paid doesn't keep getting
#   cart-recovery emails). That app's own ALLOWED_ORIGINS env var needs
#   this site's origin added for the client-side call to not be blocked
#   by CORS.
# - EMAIL_APP_WEBHOOK_SECRET: matches that app's STOREFRONT_WEBHOOK_SECRET —
#   authenticates the server-side notifyOrderReceived() call only (the
#   client-side capture call needs no secret, same as a public signup form).
# Leave both unset and both calls are simply skipped — checkout and
# fulfillment are unaffected either way.
NEXT_PUBLIC_EMAIL_APP_URL=
EMAIL_APP_WEBHOOK_SECRET=
